       ]
       deps += [
diff --git a/fxjs/xfa/cjx_node_embeddertest.cpp b/fxjs/xfa/cjx_node_embeddertest.cpp
new file mode 100644
index 000000000..ccfc12ba7
--- /dev/null
+++ b/fxjs/xfa/cjx_node_embeddertest.cpp
@@ -0,0 +1,47 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "fxjs/xfa/cjx_node.h"
+
+#include <string>
+
+#include "core/fxcrt/bytestring.h"
+#include "fxjs/fxv8.h"
+#include "fxjs/xfa/cfxjse_engine.h"
+#include "fxjs/xfa/cfxjse_isolatetracker.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "testing/xfa_js_embedder_test.h"
+
+using testing::HasSubstr;
+using testing::Not;
+
+class CJXNodeEmbedderTest : public XFAJSEmbedderTest {
+ protected:
+  std::string ExecuteToString(ByteStringView input) {
+    EXPECT_TRUE(Execute(input)) << "Program: " << input;
+
+    CFXJSE_ScopeUtil_IsolateHandleContext scope(
+        GetScriptContext()->GetJseContextForTest());
+    ByteString value =
+        fxv8::ReentrantToByteStringHelper(isolate(), GetValue());
+    return std::string(value.c_str(), value.GetLength());
+  }
+};
+
+TEST_F(CJXNodeEmbedderTest, SaveXMLKeepsFieldValue) {
+  ASSERT_TRUE(OpenDocument("xfa/xfa_multiline_textfield.pdf"));
+  ASSERT_TRUE(
+      Execute("$form.form1.Page1.TextField1.rawValue = \"FieldValue\""));
+
+  // Both the form packet and the data packet must save the value as it is,
+  // without a line break in front of it.
+  std::string form_xml = ExecuteToString("$form.saveXML()");
+  EXPECT_THAT(form_xml, HasSubstr(">FieldValue</"));
+  EXPECT_THAT(form_xml, Not(HasSubstr("\nFieldValue")));
+
+  std::string data_xml = ExecuteToString("$datasets.saveXML()");
+  EXPECT_THAT(data_xml, HasSubstr(">FieldValue</"));
+  EXPECT_THAT(data_xml, Not(HasSubstr("\nFieldValue")));
+}
diff --git a/xfa/fxfa/parser/xfa_utils.cpp b/xfa/fxfa/parser/xfa_utils.cpp
index 194c8a5bb..15d37baea 100644
--- a/xfa/fxfa/parser/xfa_utils.cpp
+++ b/xfa/fxfa/parser/xfa_utils.cpp
@@ -177,6 +177,7 @@ void RegenerateFormFile_Changed(CXFA_Node* pNode,
   }
 
   WideString wsChildren;
+  bool bChildrenAreText = false;
   switch (pNode->GetObjectType()) {
     case XFA_ObjectType::ContentNode: {
       if (!bSaveXML && !ContentNodeNeedtoExport(pNode)) {
@@ -245,6 +246,7 @@ void RegenerateFormFile_Changed(CXFA_Node* pNode,
         WideString wsValue =
             pRawValueNode->JSObject()->GetCData(XFA_Attribute::Value);
         wsChildren += ExportEncodeContent(wsValue);
+        bChildrenAreText = true;
       }
       break;
     }
@@ -253,6 +255,7 @@ void RegenerateFormFile_Changed(CXFA_Node* pNode,
     case XFA_ObjectType::NodeV: {
       WideString wsValue = pNode->JSObject()->GetCData(XFA_Attribute::Value);
       wsChildren += ExportEncodeContent(wsValue);
+      bChildrenAreText = true;
       break;
     }
     default:
@@ -297,7 +300,9 @@ void RegenerateFormFile_Changed(CXFA_Node* pNode,
     if (wsChildren.IsEmpty()) {
       buf << "/>\n";
     } else {
-      buf << ">\n" << wsChildren << "</" << wsElement << ">\n";
+      // A line break before text would become part of that text.
+      buf << (bChildrenAreText ? ">" : ">\n") << wsChildren << "</"
+          << wsElement << ">\n";
     }
   }
 }
