+int32_t CPDF_BAFontMap::GetFallbackFontIndex() {
+  if (!g_fallback_font_loader) {
+    return -1;
+  }
+
+  const ByteString alias(kFallbackFontAlias);
+  int32_t index = FindFont(alias, FX_Charset::kDefault);
+  if (index >= 0) {
+    return index;
+  }
+
+  RetainPtr<CPDF_Dictionary> pRootDict = document_->GetMutableRoot();
+  RetainPtr<CPDF_Dictionary> pAcroFormDict =
+      pRootDict ? pRootDict->GetMutableDictFor(pdfium::catalog::kAcroForm)
+                : nullptr;
+  RetainPtr<CPDF_Dictionary> pDRFontDict =
+      pAcroFormDict
+          ? pAcroFormDict->GetOrCreateDictFor("DR")->GetOrCreateDictFor("Font")
+          : nullptr;
+
+  RetainPtr<CPDF_Font> font;
+  if (pDRFontDict) {
+    if (RetainPtr<CPDF_Dictionary> pFontDict =
+            pDRFontDict->GetMutableDictFor(alias.AsStringView())) {
+      font = CPDF_DocPageData::FromDocument(document_)->GetFont(pFontDict);
+    }
+  }
+  if (!font) {
+    font = g_fallback_font_loader(document_);
+    if (!font) {
+      return -1;
+    }
+    if (pDRFontDict) {
+      pDRFontDict->SetNewFor<CPDF_Reference>(alias, document_,
+                                             font->GetFontDictObjNum());
+    }
+  }
+
+  AddFontToAnnotDict(font, alias);
+  return AddFontData(font, alias, FX_Charset::kDefault);
+}
