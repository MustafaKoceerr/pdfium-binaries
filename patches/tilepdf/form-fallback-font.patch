+namespace {
+
+// TilePDF: the fallback form font's bytes. FreeType reads the face from them
+// for as long as the process runs, so they are set once and never freed.
+std::vector<uint8_t>& FormFallbackFontData() {
+  static std::vector<uint8_t>* data = new std::vector<uint8_t>();
+  return *data;
+}
+
+RetainPtr<CPDF_Font> LoadFormFallbackFont(CPDF_Document* doc) {
+  const std::vector<uint8_t>& data = FormFallbackFontData();
+  if (data.empty()) {
+    return nullptr;
+  }
+  pdfium::span<const uint8_t> span(data);
+  auto font = std::make_unique<CFX_Font>();
+  if (!font->LoadFaceZeroFromSpan(span, /*force_vertical=*/false,
+                                  /*object_tag=*/0)) {
+    return nullptr;
+  }
+  return LoadCompositeFont(doc, std::move(font), span, FPDF_FONT_TRUETYPE);
+}
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDF_TilePdfSetFormFallbackFont(const uint8_t* data, uint32_t size) {
+  std::vector<uint8_t>& stored = FormFallbackFontData();
+  if (!stored.empty()) {
+    return false;
+  }
+  if (!data || size == 0) {
+    return false;
+  }
+  // SAFETY: required from caller.
+  auto span = UNSAFE_BUFFERS(pdfium::span(data, size));
+  stored.assign(span.begin(), span.end());
+  CPDF_BAFontMap::SetFallbackFontLoader(&LoadFormFallbackFont);
+  return true;
+}
