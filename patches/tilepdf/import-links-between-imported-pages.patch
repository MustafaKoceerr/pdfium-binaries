+// TilePDF: page 1 links to page 2, which is imported after it, and page 2
+// links back to page 1.
+TEST_F(FPDFPPOEmbedderTest, ImportKeepsLinksBetweenImportedPages) {
+  ASSERT_TRUE(OpenDocument("import_forward_links.pdf"));
+
+  ScopedFPDFDocument new_doc(FPDF_CreateNewDocument());
+  ASSERT_TRUE(new_doc);
+
+  static constexpr int kIndices[] = {0, 1};
+  ASSERT_TRUE(FPDF_ImportPagesByIndex(new_doc.get(), document(), kIndices,
+                                      std::size(kIndices), 0));
+  ASSERT_EQ(2, FPDF_GetPageCount(new_doc.get()));
+
+  for (int page_index = 0; page_index < 2; ++page_index) {
+    ScopedFPDFPage page(FPDF_LoadPage(new_doc.get(), page_index));
+    ASSERT_TRUE(page);
+    int start_pos = 0;
+    FPDF_LINK link = nullptr;
+    ASSERT_TRUE(FPDFLink_Enumerate(page.get(), &start_pos, &link));
+    FPDF_DEST dest = FPDFLink_GetDest(new_doc.get(), link);
+    ASSERT_TRUE(dest);
+    EXPECT_EQ(1 - page_index, FPDFDest_GetDestPageIndex(new_doc.get(), dest));
+  }
+}
