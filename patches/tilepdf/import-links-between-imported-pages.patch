     return false;
   }
 
-  int curpage = index;
+  // TilePDF: every imported page gets its new page, and its object number
+  // mapped, before any is copied. A link or annotation on an imported page
+  // that refers to an imported page further on then keeps it, instead of
+  // being dropped as a reference to a page that isn't copied.
+  std::vector<RetainPtr<const CPDF_Dictionary>> src_page_dicts;
+  src_page_dicts.reserve(page_indices.size());
   for (uint32_t pageIndex : page_indices) {
-    RetainPtr<CPDF_Dictionary> dest_page_dict = dest()->CreateNewPage(curpage);
     RetainPtr<const CPDF_Dictionary> src_page_dict =
         src()->GetPageDictionary(pageIndex);
-    if (!src_page_dict || !dest_page_dict) {
+    if (!src_page_dict) {
       return false;
     }
+    src_page_dicts.push_back(std::move(src_page_dict));
+  }
+
+  std::vector<RetainPtr<CPDF_Dictionary>> dest_page_dicts;
+  dest_page_dicts.reserve(src_page_dicts.size());
+  int curpage = index;
+  for (size_t i = 0; i < src_page_dicts.size(); ++i) {
+    RetainPtr<CPDF_Dictionary> dest_page_dict = dest()->CreateNewPage(curpage);
+    if (!dest_page_dict) {
+      return false;
+    }
+    dest_page_dicts.push_back(std::move(dest_page_dict));
+    ++curpage;
+  }
+
+  // In reverse, so that a page imported twice is referred to as its first
+  // copy.
+  for (size_t i = src_page_dicts.size(); i-- > 0;) {
+    AddObjectMapping(src_page_dicts[i]->GetObjNum(),
+                     dest_page_dicts[i]->GetObjNum());
+  }
+
+  for (size_t i = 0; i < src_page_dicts.size(); ++i) {
+    const RetainPtr<const CPDF_Dictionary>& src_page_dict = src_page_dicts[i];
+    const RetainPtr<CPDF_Dictionary>& dest_page_dict = dest_page_dicts[i];
 
     // Clone the page dictionary
     CPDF_DictionaryLocker locker(src_page_dict);
@@ -81,11 +113,7 @@ bool CPDF_PageExporter::ExportPages(pdfium::span<const uint32_t> page_indices,
                     pdfium::page_object::kRotate);
 
     // Update the reference
