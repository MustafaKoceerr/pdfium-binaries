@@ -110,9 +111,18 @@ bool CPDF_PageOrganizer::UpdateReference(RetainPtr<CPDF_Object> obj) {
     case CPDF_Object::kArray: {
       CPDF_Array* array = obj->AsMutableArray();
       for (size_t i = 0; i < array->size(); ++i) {
-        if (!UpdateReference(array->GetMutableObjectAt(i))) {
-          return false;
+        RetainPtr<CPDF_Object> element = array->GetMutableObjectAt(i);
+        if (UpdateReference(element)) {
+          continue;
         }
+        // TilePDF: a reference to an object that doesn't exist is the null
+        // object (ISO 32000-1, 7.3.10). Copy it as null rather than losing the
+        // whole array, such as a page's /Contents for one missing stream.
+        if (element->IsReference() && !element->GetDirect()) {
+          array->SetNewAt<CPDF_Null>(i);
+          continue;
+        }
+        return false;
       }
       return true;
     }
