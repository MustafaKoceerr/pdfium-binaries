+// TilePDF: the page's /Contents is [6 0 R 7 0 R] and object 7 doesn't exist.
+TEST_F(FPDFPPOEmbedderTest, ImportWithMissingContentStream) {
+  ASSERT_TRUE(OpenDocument("bug_455199.pdf"));
+  int object_count = 0;
+  {
+    ScopedPage page = LoadScopedPage(0);
+    ASSERT_TRUE(page);
+    object_count = FPDFPage_CountObjects(page.get());
+    ASSERT_GT(object_count, 0);
+  }
+
+  ScopedFPDFDocument new_doc(FPDF_CreateNewDocument());
+  ASSERT_TRUE(new_doc);
+
+  static constexpr int kIndices[] = {0};
+  EXPECT_TRUE(FPDF_ImportPagesByIndex(new_doc.get(), document(), kIndices,
+                                      std::size(kIndices), 0));
+
+  ASSERT_EQ(1, FPDF_GetPageCount(new_doc.get()));
+  ScopedFPDFPage new_page(FPDF_LoadPage(new_doc.get(), 0));
+  ASSERT_TRUE(new_page);
+  EXPECT_EQ(object_count, FPDFPage_CountObjects(new_page.get()));
+  CompareDisplayList(RenderPageToDisplayList(new_page.get()), "hello_world");
+}
