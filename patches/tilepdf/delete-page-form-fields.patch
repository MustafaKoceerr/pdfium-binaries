+// TilePDF: page 1 has the fields "OnlyOnFirst" and "Group.Inner" and one of
+// the two widgets of "Shared"; page 2 has "OnlyOnSecond" and the other.
+TEST_F(FPDFDocEmbedderTest, DeletePageRemovesItsFormFields) {
+  ASSERT_TRUE(OpenDocument("delete_page_form_fields.pdf"));
+  ASSERT_EQ(2, FPDF_GetPageCount(document()));
+
+  FPDFPage_Delete(document(), 0);
+  ASSERT_EQ(1, FPDF_GetPageCount(document()));
+
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document());
+  ASSERT_TRUE(doc);
+  RetainPtr<const CPDF_Dictionary> acroform =
+      doc->GetRoot()->GetDictFor("AcroForm");
+  ASSERT_TRUE(acroform);
+  RetainPtr<const CPDF_Array> fields = acroform->GetArrayFor("Fields");
+  ASSERT_TRUE(fields);
+  EXPECT_EQ(2u, fields->size());
+  RetainPtr<const CPDF_Array> calculation_order = acroform->GetArrayFor("CO");
+  ASSERT_TRUE(calculation_order);
+  EXPECT_EQ(1u, calculation_order->size());
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  const std::string saved = GetString();
+  EXPECT_EQ(std::string::npos, saved.find("(OnlyOnFirst)"));
+  EXPECT_EQ(std::string::npos, saved.find("(first page value)"));
+  EXPECT_EQ(std::string::npos, saved.find("(Group)"));
+  EXPECT_EQ(std::string::npos, saved.find("(Inner)"));
+  EXPECT_NE(std::string::npos, saved.find("(OnlyOnSecond)"));
+  EXPECT_NE(std::string::npos, saved.find("(Shared)"));
+  // The page content; the deleted widget's appearance stream is gone.
+  EXPECT_EQ(1, CountStreamEntries(saved));
+
+  ScopedSavedDoc saved_doc = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_doc);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(0);
+  ASSERT_TRUE(saved_page);
+  EXPECT_EQ(2, FPDFPage_GetAnnotCount(saved_page.get()));
+}
