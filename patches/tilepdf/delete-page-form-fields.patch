+// TilePDF: deleting a page also takes its form fields out of the form, as
+// Acrobat and qpdf do, so a deleted page's filled-in values don't stay in the
+// file. A field with widgets on other pages keeps those.
+
+constexpr int kMaxFieldTreeDepth = 32;
+
+// Object numbers of the widget annotations on `page_dict`.
+std::set<uint32_t> GetWidgetObjNums(const CPDF_Dictionary* page_dict) {
+  std::set<uint32_t> widgets;
+  RetainPtr<const CPDF_Array> annots =
+      page_dict ? page_dict->GetArrayFor("Annots") : nullptr;
+  if (!annots) {
+    return widgets;
+  }
+  for (size_t i = 0; i < annots->size(); ++i) {
+    RetainPtr<const CPDF_Dictionary> annot = annots->GetDictAt(i);
+    if (annot && annot->GetObjNum() &&
+        annot->GetNameFor(pdfium::annotation::kSubtype) == "Widget") {
+      widgets.insert(annot->GetObjNum());
+    }
+  }
+  return widgets;
+}
+
+// Takes the widgets in `widgets` out of the field tree under `field`.
+// Returns whether `field` itself goes: it is one of the widgets, or every
+// one of its kids went. What goes is added to `removed`.
+bool PruneFormField(CPDF_Dictionary* field,
+                    const std::set<uint32_t>& widgets,
+                    int depth,
+                    std::set<const CPDF_Dictionary*>* visited,
+                    std::set<uint32_t>* removed) {
+  if (field->GetObjNum() && pdfium::Contains(widgets, field->GetObjNum())) {
+    return true;
+  }
+  if (depth > kMaxFieldTreeDepth || !visited->insert(field).second) {
+    return false;
+  }
+  RetainPtr<CPDF_Array> kids =
+      field->GetMutableArrayFor(pdfium::form_fields::kKids);
+  if (!kids || kids->IsEmpty()) {
+    return false;
+  }
+  for (size_t i = kids->size(); i-- > 0;) {
+    RetainPtr<CPDF_Dictionary> kid = kids->GetMutableDictAt(i);
+    if (kid && PruneFormField(kid.Get(), widgets, depth + 1, visited,
+                              removed)) {
+      if (kid->GetObjNum()) {
+        removed->insert(kid->GetObjNum());
+      }
+      kids->RemoveAt(i);
+    }
+  }
+  return kids->IsEmpty();
+}
+
+void RemoveWidgetsFromForm(CPDF_Document* doc, std::set<uint32_t> widgets) {
+  if (widgets.empty()) {
+    return;
+  }
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  RetainPtr<CPDF_Dictionary> acroform =
+      root ? root->GetMutableDictFor(pdfium::catalog::kAcroForm) : nullptr;
+  // An XFA form describes its fields again in its template; leave it alone.
+  if (!acroform || acroform->KeyExist("XFA")) {
+    return;
+  }
+  // A widget that is on a page still, as page trees may share annotations,
+  // stays.
+  for (int i = 0; i < doc->GetPageCount() && !widgets.empty(); ++i) {
+    for (uint32_t objnum : GetWidgetObjNums(doc->GetPageDictionary(i).Get())) {
+      widgets.erase(objnum);
+    }
+  }
+  RetainPtr<CPDF_Array> fields = acroform->GetMutableArrayFor("Fields");
+  if (widgets.empty() || !fields) {
+    return;
+  }
+  std::set<const CPDF_Dictionary*> visited;
+  std::set<uint32_t> removed;
+  for (size_t i = fields->size(); i-- > 0;) {
+    RetainPtr<CPDF_Dictionary> field = fields->GetMutableDictAt(i);
+    if (field && PruneFormField(field.Get(), widgets, 0, &visited, &removed)) {
+      if (field->GetObjNum()) {
+        removed.insert(field->GetObjNum());
+      }
+      fields->RemoveAt(i);
+    }
+  }
+  // The calculation order lists fields by reference.
+  RetainPtr<CPDF_Array> calculation_order = acroform->GetMutableArrayFor("CO");
+  if (!calculation_order) {
+    return;
+  }
+  for (size_t i = calculation_order->size(); i-- > 0;) {
+    RetainPtr<const CPDF_Object> entry = calculation_order->GetObjectAt(i);
+    const CPDF_Reference* ref = entry ? entry->AsReference() : nullptr;
+    if (ref && pdfium::Contains(removed, ref->GetRefObjNum())) {
+      calculation_order->RemoveAt(i);
+    }
+  }
+}
+
 }  // namespace
 
