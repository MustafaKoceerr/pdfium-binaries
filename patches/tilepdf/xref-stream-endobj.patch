 }
+
+// TilePDF: the last cross-reference section of embedded_attachments.pdf is a
+// cross-reference stream, so an incremental save appends one.
+TEST_F(CPDFCreatorEmbedderTest, IncrementalSaveEndsXrefStreamObject) {
+  ASSERT_TRUE(OpenDocument("embedded_attachments.pdf"));
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_INCREMENTAL));
+
+  const std::string saved_data = GetString();
+  const size_t last_endstream = saved_data.rfind("endstream");
+  ASSERT_NE(std::string::npos, last_endstream);
+  EXPECT_THAT(saved_data.substr(last_endstream),
+              testing::StartsWith("endstream\r\nendobj\r\nstartxref\r\n"));
+
+  ScopedSavedDoc saved_document = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_document);
+  EXPECT_TRUE(FPDF_DocumentHasValidCrossReferenceTable(saved_document.get()));
+}
