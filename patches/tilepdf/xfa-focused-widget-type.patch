 #ifdef PDF_ENABLE_XFA
 #include "fpdfsdk/fpdfxfa/cpdfxfa_context.h"
 #include "fpdfsdk/fpdfxfa/cpdfxfa_page.h"
+#include "fpdfsdk/fpdfxfa/cpdfxfa_widget.h"
+#include "xfa/fxfa/cxfa_ffwidget.h"
+#include "xfa/fxfa/parser/cxfa_node.h"
 #endif  // PDF_ENABLE_XFA
 
 #if defined(PDF_USE_SKIA)
@@ -1019,3 +1022,23 @@ FORM_SetTextDirection(FPDF_FORMHANDLE handle,
 
   return true;
 }
+
+FPDF_EXPORT int FPDF_CALLCONV
+FORM_TilePdfGetFocusedXfaWidgetType(FPDF_FORMHANDLE handle) {
+#ifdef PDF_ENABLE_XFA
+  CPDFSDK_FormFillEnvironment* form_fill_env =
+      CPDFSDKFormFillEnvironmentFromFPDFFormHandle(handle);
+  if (!form_fill_env) {
+    return -1;
+  }
+  CPDFSDK_Annot* annot = form_fill_env->GetFocusAnnot();
+  CPDFXFA_Widget* widget = annot ? annot->AsXFAWidget() : nullptr;
+  CXFA_FFWidget* ffwidget = widget ? widget->GetXFAFFWidget() : nullptr;
+  if (!ffwidget || !ffwidget->GetNode()) {
+    return -1;
+  }
+  return static_cast<int>(ffwidget->GetNode()->GetFFWidgetType());
+#else
+  return -1;
+#endif  // PDF_ENABLE_XFA
+}
