+// TilePDF: annotation 0 is a popup whose /Parent is annotation 1, and
+// annotation 2 is a widget whose /Parent is a form field.
+TEST_F(FPDFPPOEmbedderTest, ImportTranslatesAnnotationParents) {
+  ASSERT_TRUE(OpenDocument("import_annot_parents.pdf"));
+
+  ScopedFPDFDocument new_doc(FPDF_CreateNewDocument());
+  ASSERT_TRUE(new_doc);
+  // A few pages first, so that the source's object numbers are taken by
+  // unrelated objects in the new document.
+  for (int i = 0; i < 3; ++i) {
+    ScopedFPDFPage page(FPDFPage_New(new_doc.get(), i, 200, 200));
+    ASSERT_TRUE(page);
+  }
+
+  static constexpr int kIndices[] = {0};
+  ASSERT_TRUE(FPDF_ImportPagesByIndex(new_doc.get(), document(), kIndices,
+                                      std::size(kIndices), 3));
+  ASSERT_TRUE(FPDF_SaveAsCopy(new_doc.get(), this, 0));
+
+  ScopedSavedDoc saved_doc = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_doc);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(3);
+  ASSERT_TRUE(saved_page);
+  ASSERT_EQ(3, FPDFPage_GetAnnotCount(saved_page.get()));
+
+  ScopedFPDFAnnotation popup(FPDFPage_GetAnnot(saved_page.get(), 0));
+  ASSERT_TRUE(popup);
+  EXPECT_EQ(FPDF_ANNOT_POPUP, FPDFAnnot_GetSubtype(popup.get()));
+  ScopedFPDFAnnotation parent(FPDFAnnot_GetLinkedAnnot(popup.get(), "Parent"));
+  ASSERT_TRUE(parent);
+  EXPECT_EQ(1, FPDFPage_GetAnnotIndex(saved_page.get(), parent.get()));
+
+  ScopedFPDFAnnotation widget(FPDFPage_GetAnnot(saved_page.get(), 2));
+  ASSERT_TRUE(widget);
+  EXPECT_EQ(FPDF_ANNOT_WIDGET, FPDFAnnot_GetSubtype(widget.get()));
+  EXPECT_FALSE(FPDFAnnot_HasKey(widget.get(), "Parent"));
+}
